siml 1
spec dps_warrior

var ${Battle Shout: No Raid Buff} =
    not (aura(battle_shout_11551_external).is_known or aura(battle_shout_external).is_known)
var ${Delay Check} =
    spell(bloodthirst).time_to_ready >= spell(bloodthirst).gcd_hasted_duration
    and spell(whirlwind).time_to_ready >= spell(whirlwind).gcd_hasted_duration
var ${Overpower: Can Cast} =
    action_group_used("Overpower Weaving")
    and aura(overpower).is_active(include_reaction_time=true)
    and current_rage >= 5
    and current_rage <= 73
    and spell(overpower).is_ready
var ${Rend: Can Cast} =
    action_group_used("Rend Weave ON/OFF")
    and not is_execute_phase(e20)
    and not dot(rend).is_active
    and current_rage >= 10
var ${Battle Stance: Swap Ready} = spell(battle_stance).time_to_ready <= 0s
var ${Battle Stance: Wanted} = $overpower_can_cast or $rend_can_cast
var ${Resource Potion: Rage} =
    selected_potion(item.rage_potion, slot=resource_potion)
    or selected_potion(item.great_rage_potion, slot=resource_potion)
    or selected_potion(item.mighty_rage_potion, slot=resource_potion)
var ${Offensive Potion: Rage} =
    selected_potion(item.rage_potion, slot=offensive_potion)
    or selected_potion(item.great_rage_potion, slot=offensive_potion)
    or selected_potion(item.mighty_rage_potion, slot=offensive_potion)

prepull:
  -4.5s cast berserker_rage
  -3s cast bloodrage
  -3s cast battle_shout
  -1.5s cast reckless_swings
  -0.9s group "Pre-pull: Move"

priority:
  # group "Recklessness ON/OFF"
  group "Rend Weave ON/OFF"
  group "Hamstring Weave ON/OFF"
  group "Engineering"
  group "CD: Trinkets"
  group "Sunder Armor" if number_targets == 1
  # group "Sunder Armor: Refresh" if number_targets == 1
  cast other.offensive_potion
      if not $offensive_potion_rage
      and multiple_cd_usages(target_spell_id=other.offensive_potion, offset=0ms, align_cd_end=true)
  group "CD: Racials"
  cast death_wish if multiple_cd_usages(target_spell_id=death_wish, offset=0ms, align_cd_end=true)
  cast recklessness
      if action_group_used("Recklessness ON/OFF")
      and multiple_cd_usages(target_spell_id=recklessness, offset=0ms, align_cd_end=true)
  cast sweeping_strikes if and(number_targets > 1)
  cast whirlwind if number_targets > 1
  group "Overpower Weaving"
  strict_sequence(cast battle_stance, cast spearing_strike)
      if spell(spearing_strike).is_known
      and spell(spearing_strike).time_to_ready <= 0s
      and current_rage >= 15
      and $battle_stance_swap_ready
      and not is_execute_phase(e20)
      and $delay_check
      and (target_is_mob_type(dragonkin) or target_is_mob_type(giant))
  cast spearing_strike if aura(battle_stance).is_active
  cast execute if is_execute_phase(e20)
  cast whirlwind
  cast cleave if number_targets > 1 and current_rage >= 25
  cast bloodthirst
  cast heroic_strike
      if number_targets == 1 and not is_execute_phase(e20) and current_rage >= 40
      or $delay_check and current_rage > 60
  strict_sequence(cast battle_stance, cast rend)
      if number_targets == 1
      and $rend_can_cast
      and $battle_stance_swap_ready
  cast rend if $rend_can_cast
  cast berserker_stance if aura(battle_stance).is_active and not $battle_stance_wanted
  cast hamstring
      if action_group_used("Hamstring Weave ON/OFF")
      and aura(windfury_totem_proc).is_known
      and $delay_check
      and not is_execute_phase(e20)
      and number_targets < 2
  cast other.resource_potion if not $resource_potion_rage or current_rage <= 30
  cast other.offensive_potion if $offensive_potion_rage and current_rage <= 30
  cast reckless_swings
  cast bloodrage
      if remaining_time > spell(bloodrage).full_cooldown and current_rage < 90
      or remaining_time < 2s
      or is_execute_phase(e20) and current_rage + 10 >= spell(execute).current_cost and not spell(execute).can_cast and auto_time_to_next(melee_auto) > 0.5s and aura(berserker_stance).is_active(include_reaction_time=true)
  cast berserker_rage if $delay_check and talent_is_known(improved_berserker_rage)
  cast battle_shout
      if $delay_check
      and $battle_shout_no_raid_buff
      and aura(battle_shout).remaining_time <= 10s
  # cast berserker_stance if not aura(berserker_stance).is_active
  # cast recklessness if false
  # cast retaliation if false
  # cast shield_wall if false

group "Pre-pull: Move":
  cast charge if aura(battle_stance).is_active
  cast intercept if aura(berserker_stance).is_active

group "Recklessness ON/OFF":
  none

group "Rend Weave ON/OFF":
  none

group "Hamstring Weave ON/OFF":
  none

group "Engineering":
  cast item.goblin_sapper_charge
  cast item.crystal_charge
  cast item.ez_thro_dynamite_ii

group "CD: Racials":
  cast blood_fury if multiple_cd_usages(target_spell_id=blood_fury, offset=0ms, align_cd_end=true)
  cast berserking if multiple_cd_usages(target_spell_id=berserking, offset=0ms, align_cd_end=true)
  cast eureka if multiple_cd_usages(target_spell_id=eureka, offset=0ms, align_cd_end=true)
  cast elunes_light
      if not action_group_used("Recklessness ON/OFF")
      and multiple_cd_usages(target_spell_id=elunes_light, offset=0ms, align_cd_end=true)
  cast elunes_light
      if action_group_used("Recklessness ON/OFF")
      and aura(recklessness).is_inactive
      and remaining_time > 15s
      and (remaining_time > 195s or remaining_time <= 30s)

group "Sunder Armor":
  cast sunder_armor if target.aura(sunder_armor).num_stacks(include_reaction_time=true) < 5

group "Sunder Armor: Refresh":
  cast sunder_armor if $delay_check and target.aura(sunder_armor).remaining_time <= 10s

group "CD: Trinkets":
  cast_all_stat_buff_cooldowns(stat_type2=attack_power, stat_type3=haste_rating)
  cast_all_stat_buff_cooldowns(crit_rating, stat_type2=armor_penetration, stat_type3=-1)
  cast item.badge_of_the_swarmguard
  cast item.slayers_crest
  cast item.kiss_of_the_spider
  cast jom_gabbar
  cast item.shard_of_the_fallen_star
  cast item.everlook_pathcarver
  cast item.blackhands_breadth
      if not action_group_used("Recklessness ON/OFF")
      and (remaining_time <= 20s or remaining_time > 310s)
  cast item.blackhands_breadth
      if action_group_used("Recklessness ON/OFF")
      and aura(recklessness).is_inactive
      and remaining_time > 15s
      and (remaining_time > 320s or remaining_time <= 35s)

group "Overpower Weaving":
  strict_sequence(cast battle_stance, cast overpower)
      if $overpower_can_cast
      and aura(overpower).remaining_time > gcd_time_to_ready
      and $battle_stance_swap_ready
      and spell(overpower).time_to_ready <= 0s
  cast overpower if $overpower_can_cast
